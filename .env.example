# Copie este arquivo para ".env" e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API Keys / Data API).
# A chave pública (publishable ou anon) pode ficar no site: quem protege os dados
# são as regras do banco em supabase/schema.sql.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_KEY=sua-chave-publica
